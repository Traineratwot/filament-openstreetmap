{
  "name": "traineratwot/filament-openstreetmap",
  "version": "2.3.1",
  "description": "OpenStreetMap field for Filament forms with Leaflet.js — pick coordinates, geocode addresses, and store points in 11 formats (WKT, GeoJSON, array, DMS, map URLs)",
  "keywords": [
    "filament",
    "openstreetmap",
    "leaflet",
    "map",
    "laravel",
    "filamentphp",
    "filament-form",
    "geolocation",
    "geocoding",
    "coordinates",
    "points",
    "spatial",
    "gis",
    "wkt",
    "geojson",
    "latitude",
    "longitude"
  ],
  "categories": [
    "laravel",
    "frontend-helpers"
  ],
  "homepage": "https://github.com/traineratwot/filament-openstreetmap",
  "support": {
    "issues": "https://github.com/traineratwot/filament-openstreetmap/issues",
    "source": "https://github.com/traineratwot/filament-openstreetmap",
    "docs": "https://github.com/traineratwot/filament-openstreetmap#readme"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Traineratwot",
      "email": "traineratwot@yandex.ru",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.2",
    "filament/filament": ">=3",
    "spatie/laravel-package-tools": "^1.9"
  },
  "autoload": {
    "psr-4": {
      "Traineratwot\\FilamentOpenStreetMap\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Traineratwot\\FilamentOpenStreetMap\\FilamentOpenStreetMapServiceProvider"
      ]
    }
  },
  "archive": {
    "includes":[
      "resources",
      "src"
    ],
    "exclude": [
      ".*",
      "composer.lock",
      "/laravel-test",
      "/.gigacode",
      "/tests",
      "/.phpunit",
      "/vendor",
      "/.gitignore",
      "README.md",
      "CHANGELOG.md",
      "phpunit.xml*",
      "phpcs.xml*",
      "rector.php",
      "behat.yml"
    ]
  }
}
